# Normaliza quebras de linha: o Git guarda tudo com LF no repositorio e
# converte para o padrao do sistema no checkout.
* text=auto

# Arquivos que o Flutter regenera sempre com LF. Sem isso, o core.autocrlf
# do Windows marca todos como "modificados" a cada 'flutter pub get'.
**/flutter/generated_plugin_registrant.cc  text eol=lf
**/flutter/generated_plugin_registrant.h   text eol=lf
**/flutter/generated_plugins.cmake         text eol=lf
**/Flutter/GeneratedPluginRegistrant.swift text eol=lf
**/GeneratedPluginRegistrant.java          text eol=lf

# Scripts e arquivos de build que precisam de LF para funcionar.
*.sh       text eol=lf
gradlew    text eol=lf

# Arquivos Windows que precisam de CRLF.
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binarios: nunca converter.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.ttf      binary
*.otf      binary
*.jar      binary
*.keystore binary
